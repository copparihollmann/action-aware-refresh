From 0377dd1af7469b4328f7dec5765156447977227a Mon Sep 17 00:00:00 2001
From: action-aware-refresh <copparihollmann@berkeley.edu>
Date: Mon, 3 Aug 2026 23:48:10 -0700
Subject: [PATCH] research: capture every request, and make the open-loop
 horizon configurable
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Two additive changes to the Cosmos3 client, both off by default.

1. Capture-all. The existing single-request capture cannot support the offline
screens it feeds: a denoising-step sweep measured on one frame says nothing
about how deviation grows through a grasp, and an E0 seed-spread on one
observation has no across-observation scale to be compared against. Passing a
directory (rather than a .npz path) now captures every request, zero-padded so
lexical order matches temporal order. One episode yields ~24-30 requests for the
price of one closed-loop run.

2. Configurable open_loop_horizon. Experiment B (spec §11.2) sweeps how many
returned actions execute before the next policy call, but upstream hard-codes
32 — so the registry's fixed_horizon_8/16/32 entries would all have run at 32
while being recorded under different names, i.e. a fabricated comparison. The
override is validated and range-checked against the chunk the server actually
returns, and raises rather than falling back: a typo must not silently yield a
baseline run under an experimental label.

Both default to upstream behaviour exactly, so the official baseline is
unchanged.

Note on the first draft of this patch: inserting _resolve_open_loop_horizon
landed it inside __init__, stranding `self.client = self._connect()` after a
return. The module still imported, still compiled, and the new method's own
tests still passed — the break surfaced only as AttributeError once a request
was made, ~90 s into a closed-loop run. tests/unit/test_client_patch.py now
parses the class for unreachable code and missing __init__ assignments, and
constructs the client for real, because testing a patched method in isolation
does not test that the patch left the rest of the class intact.
---
 policies/cosmos3/client.py | 119 ++++++++++++++++++++++++++++++++-----
 1 file changed, 103 insertions(+), 16 deletions(-)

diff --git a/policies/cosmos3/client.py b/policies/cosmos3/client.py
index 283f7e2..dfca072 100644
--- a/policies/cosmos3/client.py
+++ b/policies/cosmos3/client.py
@@ -20,25 +20,62 @@ logger = logging.getLogger(__name__)
 # geometry, a prompt that tokenizes to a different length). So capture the first
 # genuine request instead, from the live closed loop, and profile that.
 #
-# Off unless ACTION_REFRESH_CAPTURE_REQUEST names an output .npz path; writes
-# exactly once per process and never raises into the control loop — a debug
-# artifact must not be able to fail an eval run.
+# Off unless ACTION_REFRESH_CAPTURE_REQUEST is set. Two modes, chosen by whether
+# the value looks like a file:
+#
+#   ...=/path/to/one.npz   -> capture only the FIRST request (original behaviour)
+#   ...=/path/to/dir/      -> capture EVERY request into that directory
+#
+# Capture-all exists because a one-request corpus cannot support the offline
+# screens it is meant to feed: a denoising-step sweep measured on a single frame
+# says nothing about how deviation grows through a grasp, and an E0 seed-spread
+# measured on one observation cannot be compared against across-observation
+# spread. One episode yields ~34 requests at ~1 MB each, which is the whole
+# trajectory for the price of one closed-loop run.
+#
+# Never raises into the control loop — a debug artifact must not be able to fail
+# an eval run.
 _CAPTURE_ENV = "ACTION_REFRESH_CAPTURE_REQUEST"
 _captured = False
+_capture_index = 0
+
 
+def _capture_task_name() -> str:
+    """Task label for capture filenames, from the launcher's ROBOLAB_TASK.
 
-def _maybe_capture_request(request: dict) -> None:
-    global _captured
-    path = os.environ.get(_CAPTURE_ENV)
-    if not path or _captured:
+    Sanitised because it becomes part of a path; an unexpected value must not be
+    able to escape the capture directory.
+    """
+    raw = os.environ.get("ROBOLAB_TASK", "") or ""
+    return "".join(c if (c.isalnum() or c in "-_") else "_" for c in raw)[:80]
+
+
+def _maybe_capture_request(request: dict, *, task: str = "") -> None:
+    global _captured, _capture_index
+    dest = os.environ.get(_CAPTURE_ENV)
+    if not dest:
+        return
+    capture_all = not dest.endswith(".npz")
+    if _captured and not capture_all:
         return
-    _captured = True  # set first: a failed write must not retry every step
+
+    index = _capture_index
+    _capture_index += 1
+    if capture_all:
+        # Zero-padded so lexical order matches temporal order — the offline harness
+        # sorts by filename, and req9 before req10 would silently reorder the
+        # trajectory.
+        stem = os.path.join(dest, f"captured_request_{task or 'task'}_req{index:04d}")
+    else:
+        _captured = True  # set before writing: a failed write must not retry every step
+        stem = os.path.splitext(dest)[0]
+
     try:
         arrays = {k: np.asarray(v) for k, v in request.items() if not isinstance(v, str)}
         meta = {k: v for k, v in request.items() if isinstance(v, str)}
-        os.makedirs(os.path.dirname(os.path.abspath(path)) or ".", exist_ok=True)
-        np.savez(path, **arrays)
-        with open(os.path.splitext(path)[0] + ".json", "w") as fh:
+        os.makedirs(os.path.dirname(os.path.abspath(stem)) or ".", exist_ok=True)
+        np.savez(stem + ".npz", **arrays)
+        with open(stem + ".json", "w") as fh:
             import json
 
             json.dump(
@@ -48,14 +85,22 @@ def _maybe_capture_request(request: dict) -> None:
                         k: {"shape": list(v.shape), "dtype": str(v.dtype)}
                         for k, v in arrays.items()
                     },
-                    "source": "Cosmos3Client._pack_request, first request of the run",
+                    "source": "Cosmos3Client._pack_request",
+                    # policy_request_index, not control step: the client calls the
+                    # policy once per OPEN_LOOP_HORIZON control steps, so this counts
+                    # server round trips, which is what the offline replay reproduces.
+                    "policy_request_index": index,
+                    "task": task,
                 },
                 fh,
                 indent=2,
             )
-        logger.info("[capture] wrote real policy request to %s", path)
+        if capture_all:
+            logger.info("[capture] request %d -> %s.npz", index, stem)
+        else:
+            logger.info("[capture] wrote real policy request to %s.npz", stem)
     except Exception as exc:  # noqa: BLE001
-        logger.warning("[capture] failed to write %s: %s", path, exc)
+        logger.warning("[capture] failed to write %s: %s", stem, exc)
 
 
 class Cosmos3Client(InferenceClient):
@@ -74,13 +119,52 @@ class Cosmos3Client(InferenceClient):
         self._image_w = self.IMAGE_W
         self._image_h = self.IMAGE_H
 
-        self.open_loop_horizon = self.OPEN_LOOP_HORIZON
+        # research/action-aware-refresh: make the open-loop horizon configurable.
+        #
+        # Experiment B (spec §11.2) sweeps how many of the returned actions are
+        # executed before the policy is called again. Upstream hard-codes 32, so
+        # without this the horizon-sweep entries in experiments/registry.yaml
+        # (baseline_fixed_horizon_8/16/32) would all run at 32 while being recorded
+        # under different names — a fabricated comparison.
+        #
+        # Validated and clamped to [1, OPEN_LOOP_HORIZON]: the server returns exactly
+        # OPEN_LOOP_HORIZON actions per call, so a larger horizon would index past the
+        # chunk. Raises on a bad value rather than falling back, so a typo cannot
+        # silently produce a baseline run under an experimental label.
+        self.open_loop_horizon = self._resolve_open_loop_horizon()
 
         display = f"{self._remote_host}:{self._remote_port}"
         print(f"[{self.__class__.__name__}] Awaiting for server on {display} to be ready...")
         self.client = self._connect()
         print(f"[{self.__class__.__name__}] Connected to {display}.")
 
+    def _resolve_open_loop_horizon(self) -> int:
+        """ """
+        raw = os.environ.get("ROBOLAB_OPEN_LOOP_HORIZON")
+        if raw is None or raw == "":
+            return self.OPEN_LOOP_HORIZON
+        try:
+            value = int(raw)
+        except ValueError as exc:
+            raise ValueError(
+                f"ROBOLAB_OPEN_LOOP_HORIZON={raw!r} is not an integer"
+            ) from exc
+        if not 1 <= value <= self.OPEN_LOOP_HORIZON:
+            raise ValueError(
+                f"ROBOLAB_OPEN_LOOP_HORIZON={value} out of range: the server returns "
+                f"{self.OPEN_LOOP_HORIZON} actions per call, so the horizon must be in "
+                f"[1, {self.OPEN_LOOP_HORIZON}]. Reusing actions beyond the chunk would "
+                "need an explicit extrapolation rule (spec §11.2), not a larger index."
+            )
+        if value != self.OPEN_LOOP_HORIZON:
+            logger.info(
+                "[%s] open_loop_horizon overridden: %d (upstream default %d)",
+                self.__class__.__name__,
+                value,
+                self.OPEN_LOOP_HORIZON,
+            )
+        return value
+
     def _connect(self) -> websocket_client_policy.WebsocketClientPolicy:
         """ """
         return websocket_client_policy.WebsocketClientPolicy(self._remote_host, self._remote_port)
@@ -150,7 +234,10 @@ class Cosmos3Client(InferenceClient):
             "observation/gripper_position": extracted_obs["gripper_position"],
             "prompt": instruction,
         }
-        _maybe_capture_request(request)  # research/action-aware-refresh; no-op unless enabled
+        # research/action-aware-refresh; no-op unless enabled. The task name comes
+        # from the launcher's own env var rather than being threaded through the
+        # client, so this stays a single-call-site addition to upstream.
+        _maybe_capture_request(request, task=_capture_task_name())
         return request
 
     def _query_server(self, request: dict) -> dict:
