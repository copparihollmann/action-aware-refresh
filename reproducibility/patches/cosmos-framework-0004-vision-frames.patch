From f98f4d5c9e1eedb2dab731c96bcf978ae344d4f9 Mon Sep 17 00:00:00 2001
From: action-aware-refresh <copparihollmann@berkeley.edu>
Date: Tue, 4 Aug 2026 00:18:57 -0700
Subject: [PATCH] research: --vision-frames, to shorten the imagined horizon
 (Experiment E2b)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The token census showed 85.3% of the 3,188-token sequence is imagined future
video — 8 of 9 latent frames — while the deliverable is 32 action tokens. The
model is matmul-bound (99.4% of counted FLOPs are aten.mm) and therefore
near-linear in token count, so shortening the imagined horizon is the largest
lever the compute anatomy identified.

No sequence-plan or attention surgery is needed. The action transform derives
video_length from the video tensor and action_length from the action tensor, and
build_sequence_plan_from_mode already supports a temporally subsampled video with
a dense action stream (its "Case C"). That requires
(action_length - 1) % (video_length - 1) == 0, so with 33 action steps the valid
frame counts are 33, 17, 9, 5 and 3 -> 9, 5, 3, 2 and 1 latent frames, i.e.
3,060 -> 340 vision tokens. Anything else is rejected at startup rather than
silently falling into a different alignment case, which would yield
plausible-looking actions from a layout the actions do not correspond to.

conditioning_fps is scaled with the frame count, because a shortened video is a
subsampled view of the SAME horizon. Two consumers need that. The caption
augmentor computes duration = int(num_frames / fps), so 9 frames at 15 fps
produced "The video is 0.0 seconds long" — a degenerate prompt that would have
confounded the experiment with a text change. And the temporal mRoPE positions
encode real elapsed time. fps is consumed as an integer, so it is rounded (never
below 1, since fps 0 makes the augmentor drop the metadata entirely). The result:
17/9/5 frames keep the caption byte-identical to the baseline's "2.0 seconds
long", varying only the frame count.

Defaults to None = upstream behaviour, so the official baseline is unchanged.
---
 .../scripts/action_policy_server_robolab.py   | 77 ++++++++++++++++++-
 1 file changed, 74 insertions(+), 3 deletions(-)

diff --git a/cosmos_framework/scripts/action_policy_server_robolab.py b/cosmos_framework/scripts/action_policy_server_robolab.py
index ab65e77..d02e56d 100644
--- a/cosmos_framework/scripts/action_policy_server_robolab.py
+++ b/cosmos_framework/scripts/action_policy_server_robolab.py
@@ -294,6 +294,23 @@ class RobolabPolicyConfig:
     action_space: ActionSpace = "joint_pos"
     use_state: bool = True
     history_length: int = 1
+    # research/action-aware-refresh: how many video frames the model is asked to
+    # imagine. None = upstream behaviour (action_chunk_size + 1).
+    #
+    # This is Experiment E2b (spec §11.5) and doubles as Experiment H. The token census
+    # showed 85.3% of the 3,188-token sequence is *imagined future video* — 8 of 9 latent
+    # frames — while the deliverable is 32 action tokens. The model is matmul-bound and
+    # near-linear in token count, so shortening the imagined horizon is the largest lever
+    # available.
+    #
+    # No sequence-plan surgery is needed: the transform derives `video_length` from the
+    # video tensor and `action_length` from the action tensor, and
+    # `build_sequence_plan_from_mode` already supports a subsampled video with a dense
+    # action stream (its "Case C"). That requires `(action_length - 1) % (video_length - 1)
+    # == 0`, so with 33 actions the valid frame counts are 33, 17, 9, 5 and 3 — giving 9,
+    # 5, 3, 2 and 1 latent frames respectively. Anything else is rejected at startup
+    # rather than silently producing a misaligned plan.
+    vision_frames: int | None = None
 
 
 class RobolabServerArgs(pydantic.BaseModel):
@@ -355,6 +372,10 @@ class RobolabServerArgs(pydantic.BaseModel):
     """Whether the first action row contains the current state."""
     history_length: int = 1
     """State/history action rows to trim from the generated action output."""
+    vision_frames: int | None = None
+    """research/action-aware-refresh: video frames to imagine (default action_chunk_size+1).
+    Shortening this cuts the imagined-future tokens that dominate the sequence (85.3% of
+    3,188). Must keep the action stream aligned — validated at startup."""
     format_prompt_as_json: bool | None = None
     """Serve prompts as structured JSON (matching training ``format_prompt_as_json``)."""
 
@@ -416,11 +437,34 @@ class RobolabPolicyService:
             action_space=args.action_space,
             use_state=bool(args.use_state),
             history_length=int(args.history_length),
+            vision_frames=(int(args.vision_frames) if args.vision_frames else None),
         )
         if self.cfg.history_length < (1 if self.cfg.use_state else 0):
             raise ValueError("--history-length must be >= 1 when --use-state is true")
         if self.cfg.image_height <= 0 or self.cfg.image_width <= 0:
             raise ValueError("--image-height and --image-width must be positive")
+        # research/action-aware-refresh: validate the shortened imagined horizon here,
+        # not at first request. `build_sequence_plan_from_mode` accepts a subsampled
+        # video with a dense action stream only when the action stream divides evenly
+        # across the video gaps; otherwise it silently falls into a different alignment
+        # case and the actions no longer correspond to the frames they were meant to.
+        # A misaligned plan produces plausible-looking actions from a wrong layout, which
+        # is the worst possible failure for an experiment about action quality.
+        if self.cfg.vision_frames is not None:
+            vf = self.cfg.vision_frames
+            n_actions = self.cfg.action_chunk_size + (1 if self.cfg.use_state else 0)
+            if vf < 2:
+                raise ValueError(f"--vision-frames must be >= 2, got {vf}")
+            if (n_actions - 1) % (vf - 1) != 0:
+                valid = [
+                    v for v in range(2, self.cfg.action_chunk_size + 2)
+                    if (n_actions - 1) % (v - 1) == 0
+                ]
+                raise ValueError(
+                    f"--vision-frames={vf} misaligns the action stream: with "
+                    f"{n_actions} action steps, (n_actions-1) must divide evenly by "
+                    f"(vision_frames-1). Valid values here: {valid}"
+                )
 
         self._lock = threading.Lock()
         self._rng = np.random.default_rng(self.cfg.seed)
@@ -430,7 +474,8 @@ class RobolabPolicyService:
             f"chunk={self.cfg.action_chunk_size} history={self.cfg.history_length} use_state={self.cfg.use_state} "
             f"image={self.cfg.image_height}x{self.cfg.image_width} fps={self.cfg.conditioning_fps} "
             f"guidance={self.cfg.guidance} num_steps={self.cfg.num_steps} shift={self.cfg.shift} "
-            f"seed={self.cfg.seed} deterministic_seed={self.cfg.deterministic_seed}"
+            f"seed={self.cfg.seed} deterministic_seed={self.cfg.deterministic_seed} "
+            f"vision_frames={self.cfg.vision_frames or (self.cfg.action_chunk_size + 1)}"
         )
 
     def _build_setup_args(self, args: RobolabServerArgs) -> OmniSetupArgs:
@@ -528,8 +573,34 @@ class RobolabPolicyService:
         image_w = self.cfg.image_width
         if image.shape[:2] != (image_h, image_w):
             image = _resize_rgb_uint8(image, (image_h, image_w))
-        t_frames = self.cfg.action_chunk_size + 1
+        # research/action-aware-refresh: shorten the imagined horizon when asked.
+        # Validated in __init__, so by here it is known to keep the action alignment.
+        full_frames = self.cfg.action_chunk_size + 1
+        t_frames = self.cfg.vision_frames or full_frames
         video = torch.zeros((3, t_frames, image_h, image_w), dtype=torch.uint8)  # [3,T,H,W]
+
+        # A shortened video is a *temporally subsampled* view of the SAME horizon (the
+        # action stream stays dense at 32 steps), so its effective frame rate is lower.
+        # Both consumers of fps need that: `DurationFPSTextTimeStamps` computes
+        # `duration = int(num_frames / fps)` for the conditioning caption — at 9 frames
+        # and 15 fps that yields "The video is 0.0 seconds long", a degenerate prompt
+        # that would confound the experiment with a text change — and the temporal mRoPE
+        # positions encode real elapsed time. Scaling fps keeps the described and encoded
+        # horizon equal to the baseline's, so the only variable is how many frames span it.
+        #
+        # fps is consumed as an integer (`dtype=torch.long` below, matching upstream),
+        # so round rather than truncate and never go below 1 — at fps 0 the caption
+        # augmentor's `if fps > 0` guard drops the metadata entirely, silently changing
+        # the prompt in a different way. With chunk 32 and 15 fps this gives:
+        #   33 frames -> 15 fps, "2.0 seconds"  (baseline)
+        #   17 frames ->  8 fps, "2.0 seconds"
+        #    9 frames ->  4 fps, "2.0 seconds"
+        #    5 frames ->  2 fps, "2.0 seconds"
+        #    3 frames ->  1 fps, "3.0 seconds"  <-- only this one alters the caption
+        # so 17/9/5 vary *only* the frame count, which is what the experiment wants.
+        fps = float(self.cfg.conditioning_fps)
+        if t_frames != full_frames and t_frames > 1:
+            fps = max(1.0, round(fps * (t_frames - 1) / (full_frames - 1)))
         video[:, 0] = torch.from_numpy(image.copy()).permute(2, 0, 1)  # [3,H,W]
 
         use_state_rows = 1 if self.cfg.use_state else 0
@@ -575,7 +646,7 @@ class RobolabPolicyService:
             "ai_caption": prompt,
             "video": video,
             "action": action,
-            "conditioning_fps": torch.tensor(self.cfg.conditioning_fps, dtype=torch.long),  # []
+            "conditioning_fps": torch.tensor(fps, dtype=torch.long),  # []
             "mode": "wam",
             "domain_id": torch.tensor(get_domain_id(self.cfg.domain_name), dtype=torch.long),  # []
             "viewpoint": "concat_view",
-- 
